# secrets
.env
.env.local
*.local

# dependencies
node_modules/
.venv/
__pycache__/

# media — large binaries, kept out of git (back up separately)
assets/raw-footage/*
assets/renders/*
!assets/raw-footage/.gitkeep
!assets/renders/.gitkeep
# ...except the social profile assets: small PNGs that ARE the deliverable, plus the
# vendored webfonts their generator needs. Kept in git so a rebuild is reproducible.
!assets/renders/social/
!assets/renders/social/*.png
!assets/renders/social/README.md
*.mp4
*.mov
*.wav
*.mp3

# build / tmp
dist/
out/
.cache/
.DS_Store

# office temp/lock files
~$*

# generated weekly-report Word renders (markdown is canonical; docx is regenerated for Slack)
docs/reports/*.docx

# slack watcher local state + logs (machine-local, not secret but not shared)
.slack-watch-state.json
.slack-last-thread
logs/*.log

# personal data — client/contact lists (PII). NEVER commit: the GitHub remote is PUBLIC.
# Only the README in that folder is tracked.
data/contacts/*
!data/contacts/README.md
