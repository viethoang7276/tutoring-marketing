# Copy to .env and fill in. Never commit .env.

# --- Edlintics app (data source over /api/v1) ---
EDLINTICS_API_BASE=http://localhost:3000/api/v1
EDLINTICS_API_TOKEN=            # read-only token (to be issued on the app side)

# --- Brain ---
ANTHROPIC_API_KEY=

# --- Creative / render (added per slice, not needed for Tier 1) ---
CANVA_API_KEY=
HIGGSFIELD_API_KEY=
DEEPGRAM_API_KEY=               # or GROQ_API_KEY for Whisper

# --- Publish (Tier 2) ---
AYRSHARE_API_KEY=
