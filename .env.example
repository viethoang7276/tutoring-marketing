# Copy to .env and fill in. Never commit .env.

# --- Edlintics app (data source over /api/v1) ---
EDLINTICS_API_BASE=http://localhost:3000/api/v1
EDLINTICS_API_TOKEN=            # read-only token (to be issued on the app side)

# --- Slack delivery for the weekly CMO report (scripts/post_report_to_slack.py) ---
# Bot token from a Slack app with bot scopes chat:write + files:write. See docs/SLACK-SETUP.md.
SLACK_BOT_TOKEN=                 # xoxb-... (bot scopes: chat:write, files:write, channels:history, groups:history)
SLACK_CHANNEL_ID=               # C0123456789 — channel the bot is invited to
SLACK_PARENT_TS=                # optional: reply under / watch one standing thread (else .slack-last-thread)
# Two-way loop (slack_watch.py): reply in the report thread → triggers a headless CMO session
SLACK_OWNER_USER_ID=            # optional: only act on replies from this Slack user id (U...)
# CLAUDE_BIN=                   # override path to the claude binary for headless triggers
# CLAUDE_TOOLS=Bash Read Write Edit WebSearch WebFetch Glob Grep
# CLAUDE_PERMISSION_MODE=acceptEdits
# CLAUDE_TIMEOUT=900

# --- Brain ---
ANTHROPIC_API_KEY=

# --- Creative / render (added per slice, not needed for Tier 1) ---
CANVA_API_KEY=
HIGGSFIELD_API_KEY=
DEEPGRAM_API_KEY=               # or GROQ_API_KEY for Whisper

# --- Publish (Tier 2) ---
AYRSHARE_API_KEY=
