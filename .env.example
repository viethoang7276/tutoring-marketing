# Copy to .env and fill in. Never commit .env.

# --- Edlintics app (data source over /api/v1) ---
EDLINTICS_API_BASE=http://localhost:3000/api/v1
EDLINTICS_API_TOKEN=            # read-only token (to be issued on the app side)

# --- Slack delivery for the weekly CMO report (scripts/post_report_to_slack.py) ---
# Bot token from a Slack app with bot scopes chat:write + files:write. See docs/SLACK-SETUP.md.
SLACK_BOT_TOKEN=                 # xoxb-...
SLACK_CHANNEL_ID=               # C0123456789 — channel the bot is invited to
SLACK_PARENT_TS=                # optional: reply under one standing thread each week

# --- Brain ---
ANTHROPIC_API_KEY=

# --- Creative / render (added per slice, not needed for Tier 1) ---
CANVA_API_KEY=
HIGGSFIELD_API_KEY=
DEEPGRAM_API_KEY=               # or GROQ_API_KEY for Whisper

# --- Publish (Tier 2) ---
AYRSHARE_API_KEY=
